{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_USE_PUSH": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_USE_PUSH": "1",
        "EXPO_PUBLIC_API_URL": "https://cabzone.site"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_USE_PUSH": "1",
        "EXPO_PUBLIC_API_URL": "https://cabzone.site"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
