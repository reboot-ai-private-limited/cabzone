# ==============================================================================
# STATE 1: DEVELOPMENT (Local Host Environment)
# ==============================================================================
NODE_ENV=development
PORT=4000

# Local infrastructure (MongoDB single-node replica set rs0 + Redis)
MONGO_URI=mongodb://127.0.0.1:27017/cabzone_dev?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# Development secrets
JWT_ACCESS_SECRET=development-access-secret-32-characters-minimum-cabzone
JWT_REFRESH_SECRET=development-refresh-secret-32-characters-minimum-cabzone
OTP_PEPPER=development-otp-pepper-32-characters-minimum-cabzone
PAYMENT_WEBHOOK_SECRET=development-payment-webhook-secret-32-characters-min

# Development fixed OTP bypass (optional, for fast login during dev)
DEV_FIXED_OTP=000000

# Storage
CLOUDINARY_CLOUD_NAME=mock-cloud
CLOUDINARY_API_KEY=mock-key
CLOUDINARY_API_SECRET=mock-secret
