# ==============================================================================
# STATE 1: DEVELOPMENT (Local Host Environment)
# ==============================================================================
NODE_ENV=development
PORT=4000

# Private in-app ride calls are disabled until LiveKit Cloud is configured.
RIDE_CHAT_ENABLED=true
RIDE_CALL_ENABLED=false
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret

# Local infrastructure (MongoDB single-node replica set rs0 + Redis)
MONGO_URI=mongodb://127.0.0.1:27017/Cabzonee_dev?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# Development secrets
JWT_ACCESS_SECRET=development-access-secret-32-characters-minimum-Cabzonee
JWT_REFRESH_SECRET=development-refresh-secret-32-characters-minimum-Cabzonee
OTP_PEPPER=development-otp-pepper-32-characters-minimum-Cabzonee
PAYMENT_WEBHOOK_SECRET=development-payment-webhook-secret-32-characters-min

# Development fixed OTP bypass (optional, for fast login during dev)
DEV_FIXED_OTP=000000

# Trust score rollout (D-048): off | shadow | on
TRUST_SCORE_V2=on

# Storage
CLOUDINARY_CLOUD_NAME=mock-cloud
CLOUDINARY_API_KEY=mock-key
CLOUDINARY_API_SECRET=mock-secret

# Driver proximity rules: arrive within 200 m of pickup, complete within 500 m of drop (early drop bypasses the latter)
RIDE_GEOFENCE_ENABLED=true
