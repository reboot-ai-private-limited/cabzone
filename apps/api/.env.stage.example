# ==============================================================================
# STATE 2: STAGING (Pre-Production Test / QA Environment)
# ==============================================================================
NODE_ENV=stage
PORT=4000

# Staging infrastructure (MongoDB replica set rs0 + Redis)
MONGO_URI=mongodb://mongo:27017/cabzone_stage?replicaSet=rs0
REDIS_URL=redis://redis:6379

# Staging origins (e.g. staging admin dashboard)
CORS_ORIGINS=https://stage-admin.cabzone.example,http://localhost:3000
LOG_LEVEL=info

# Staging secrets (Must be at least 32 characters, generated via openssl rand -base64 48)
JWT_ACCESS_SECRET=replace-with-secure-staging-access-secret-32-chars-min
JWT_REFRESH_SECRET=replace-with-secure-staging-refresh-secret-32-chars-min
OTP_PEPPER=replace-with-secure-staging-otp-pepper-32-chars-min
PAYMENT_WEBHOOK_SECRET=replace-with-secure-staging-webhook-secret-32-chars-min

# Cloudinary
CLOUDINARY_CLOUD_NAME=staging-cloud
CLOUDINARY_API_KEY=staging-key
CLOUDINARY_API_SECRET=staging-secret

# Staging escape hatch (optional, for QA automated runs with fixed OTP)
STAGING_UNSAFE=false
DEV_FIXED_OTP=000000
