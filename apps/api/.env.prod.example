# ==============================================================================
# STATE 3: PRODUCTION (Live Customer Environment)
# ==============================================================================
NODE_ENV=production
PORT=4000

# Production infrastructure (MongoDB replica set rs0 + Redis)
MONGO_URI=mongodb://mongo:27017/Cabzonee_prod?replicaSet=rs0
REDIS_URL=redis://redis:6379

# Production origins (Live Admin Dashboard)
CORS_ORIGINS=https://admin.Cabzonee.example
LOG_LEVEL=info

# Production secrets (Generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48-production-access-secret
JWT_REFRESH_SECRET=replace-with-openssl-rand-base64-48-production-refresh-secret
OTP_PEPPER=replace-with-openssl-rand-base64-48-production-otp-pepper
PAYMENT_WEBHOOK_SECRET=replace-with-openssl-rand-base64-48-production-webhook-secret

# Production Cloudinary credentials
CLOUDINARY_CLOUD_NAME=production-cloud
CLOUDINARY_API_KEY=production-key
CLOUDINARY_API_SECRET=production-secret

# In live production, DEV_FIXED_OTP is strictly prohibited and halts the server if set.
STAGING_UNSAFE=false

# MOCK_OTP=true makes EVERY OTP 000000 and sends no SMS (works in production, SMS_PROVIDER=console is allowed).
# Phone numbers are then NOT verified: anyone who knows a number can sign in as that user (riders, drivers, admins).
# MOCK_OTP=false

# Play-review demo accounts (optional, remove after review). Up to 3 E.164 numbers that always get
# REVIEW_DEMO_OTP and never receive an SMS. Both must be set together; keep the OTP in a secret store.
# REVIEW_DEMO_PHONES=+919999900001,+919000000002
# REVIEW_DEMO_OTP=

# Direct Firebase FCM HTTP v1 push credentials (set JSON or mounted path in production)
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Wallet money (recharge via Razorpay Checkout, cashout via RazorpayX Payouts)
# Production requires live keys (rzp_live_*). Staging may use rzp_test_* keys.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=            # webhook URL: https://<api>/api/v1/driver/wallet/webhook  (events: payment.captured, order.paid)
# RAZORPAYX_ACCOUNT_NUMBER=            # enables automated payouts; omit to settle cashouts manually
# RAZORPAYX_WEBHOOK_SECRET=            # RazorpayX webhook, same URL (events: payout.processed, payout.failed, payout.rejected, payout.reversed)
