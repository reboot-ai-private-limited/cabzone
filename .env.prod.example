# Production Environment Template (.env.prod) — NEVER commit real secrets
NODE_ENV=production
PORT=4000
WEB_PORT=3000
LOG_LEVEL=info
STAGING_UNSAFE=false

# Browser-reachable HTTPS public URL for admin web bundle (or /api when proxied)
NEXT_PUBLIC_API_BASE_URL=https://admin.cabzone.in/api
API_UPSTREAM_ORIGIN=http://api:4000
CORS_ORIGINS=https://admin.cabzone.in

# Datastores
MONGO_URI=mongodb://mongo:27017/cabzone_prod?replicaSet=rs0
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=replace-with-strong-prod-redis-password

# Signing & Auth Secrets (>= 32 chars each; DEV_FIXED_OTP MUST NOT BE SET)
JWT_ACCESS_SECRET=replace-with-random-64-char-prod-access-secret
JWT_REFRESH_SECRET=replace-with-random-64-char-prod-refresh-secret
OTP_PEPPER=replace-with-random-64-char-prod-otp-pepper
PAYMENT_WEBHOOK_SECRET=replace-with-random-64-char-prod-webhook-secret

# SMS Gateway (required in production; console provider is rejected at boot)
SMS_PROVIDER=msg91
SMS_SENDER_ID=CABZON
SMS_DLT_TEMPLATE_ID=replace-with-approved-dlt-template-id
SMS_MSG91_AUTH_KEY=replace-with-prod-msg91-auth-key
SMS_TIMEOUT_MS=8000
SMS_MAX_RETRIES=2

# Payments (keep test mode until D-045 commercial payment gate is explicitly lifted)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# Private KYC Storage (Cloudinary authenticated raw assets)
CLOUDINARY_CLOUD_NAME=replace-with-prod-cloud-name
CLOUDINARY_API_KEY=replace-with-prod-cloudinary-key
CLOUDINARY_API_SECRET=replace-with-prod-cloudinary-secret

# Routing & Push
ROUTING_PROVIDER=google
GOOGLE_ROUTES_API_KEY=replace-with-prod-google-routes-key
EXPO_ACCESS_TOKEN=replace-with-prod-expo-access-token

# Monitoring & Encrypted Backup
ALERT_WEBHOOK_URL=https://alerts.cabzone.in/hooks/prod
ALERT_OWNER=platform-ops
API_LATENCY_ALERT_MS=2500
ALLOW_LOCAL_REALTIME_FALLBACK=false
BACKUP_ENCRYPTION_KEY_HEX=replace-with-64-hex-char-aes-256-key
