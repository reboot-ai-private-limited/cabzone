# Node environment: development, test, stage, production
NODE_ENV=development
PORT=4000

# Backend-only Razorpay credentials. Never use EXPO_PUBLIC_ for secrets.
RAZORPAY_MODE=test
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_test_secret
# Live mode additionally requires an activated merchant account with QR Codes access.
# RAZORPAY_WEBHOOK_SECRET=your_separate_webhook_signing_secret

# MongoDB (replica set rs0 on localhost)
MONGO_URI=mongodb://127.0.0.1:27017/Cabzonee_dev?replicaSet=rs0

# Redis URL
REDIS_URL=redis://127.0.0.1:6379

# CORS Origins
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# JWT Secrets (at least 32 characters)
JWT_ACCESS_SECRET=development-access-secret-32-characters-minimum-Cabzonee
JWT_REFRESH_SECRET=development-refresh-secret-32-characters-minimum-Cabzonee
OTP_PEPPER=development-otp-pepper-32-characters-minimum-Cabzonee

# Development Fixed OTP (6 digits; strictly forbidden when NODE_ENV=production)
DEV_FIXED_OTP=000000

# Transactional SMS Gateway: console | msg91 | twilio | webhook
SMS_PROVIDER=console
# SMS_SENDER_ID=CABZON
# SMS_DLT_TEMPLATE_ID=your_dlt_template_id
# SMS_MSG91_AUTH_KEY=your_msg91_auth_key
# SMS_TWILIO_ACCOUNT_SID=your_twilio_sid
# SMS_TWILIO_AUTH_TOKEN=your_twilio_token
# SMS_TWILIO_FROM=+15005550006
# SMS_WEBHOOK_URL=https://sms-gateway.example/send
# SMS_WEBHOOK_AUTH_TOKEN=your_sms_webhook_token
SMS_TIMEOUT_MS=8000
SMS_MAX_RETRIES=2

# Expo Push (optional access token for high-throughput authenticated delivery)
# EXPO_ACCESS_TOKEN=your_expo_access_token

# Operational Alerting & Readiness
# ALERT_WEBHOOK_URL=https://alerts.example/webhook/cabzone
ALERT_OWNER=platform-ops
API_LATENCY_ALERT_MS=2500
ALLOW_LOCAL_REALTIME_FALLBACK=false

# Webhook Secret (at least 32 characters)
PAYMENT_WEBHOOK_SECRET=development-payment-webhook-secret-32-characters-min

# Cloudinary (private authenticated storage used for KYC documents)
CLOUDINARY_CLOUD_NAME=mock-cloud
CLOUDINARY_API_KEY=mock-key
CLOUDINARY_API_SECRET=mock-secret

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
# Optional internal upstream origin when NEXT_PUBLIC_API_BASE_URL=/api same-origin proxy is used
# API_UPSTREAM_ORIGIN=http://api:4000
