# Staging Environment Template (.env.stage) — NEVER commit real secrets
NODE_ENV=stage
PORT=4000
WEB_PORT=3000
LOG_LEVEL=info
STAGING_UNSAFE=false

# Browser-reachable HTTPS public URL for admin web bundle (or /api when proxied)
NEXT_PUBLIC_API_BASE_URL=https://stage-admin.cabzone.example/api
API_UPSTREAM_ORIGIN=http://api:4000
CORS_ORIGINS=https://stage-admin.cabzone.example

# Datastores
MONGO_URI=mongodb://mongo:27017/cabzone_stage?replicaSet=rs0
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=replace-with-strong-stage-redis-password

# Signing & Auth Secrets (>= 32 chars each)
JWT_ACCESS_SECRET=replace-with-random-64-char-stage-access-secret
JWT_REFRESH_SECRET=replace-with-random-64-char-stage-refresh-secret
OTP_PEPPER=replace-with-random-64-char-stage-otp-pepper
PAYMENT_WEBHOOK_SECRET=replace-with-random-64-char-stage-webhook-secret

# SMS Gateway (required when STAGING_UNSAFE=false)
SMS_PROVIDER=msg91
SMS_SENDER_ID=CABZON
SMS_DLT_TEMPLATE_ID=replace-with-approved-dlt-template-id
SMS_MSG91_AUTH_KEY=replace-with-stage-msg91-auth-key
SMS_TIMEOUT_MS=8000
SMS_MAX_RETRIES=2

# Payments (Razorpay test mode in staging)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-stage-webhook-secret

# Private KYC Storage (Cloudinary authenticated raw assets)
CLOUDINARY_CLOUD_NAME=replace-with-stage-cloud-name
CLOUDINARY_API_KEY=replace-with-stage-cloudinary-key
CLOUDINARY_API_SECRET=replace-with-stage-cloudinary-secret

# Routing & Push
ROUTING_PROVIDER=google
GOOGLE_ROUTES_API_KEY=replace-with-stage-google-routes-key
EXPO_ACCESS_TOKEN=replace-with-stage-expo-access-token

# Monitoring & Encrypted Backup
ALERT_WEBHOOK_URL=https://alerts.cabzone.example/hooks/stage
ALERT_OWNER=platform-ops
API_LATENCY_ALERT_MS=2500
ALLOW_LOCAL_REALTIME_FALLBACK=false
BACKUP_ENCRYPTION_KEY_HEX=replace-with-64-hex-char-aes-256-key
