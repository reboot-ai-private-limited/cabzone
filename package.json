{
  "name": "cabzone",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@cabzone/api",
    "dev:worker": "turbo run dev:worker --filter=@cabzone/api",
    "dev:backend": "turbo run dev dev:worker --filter=@cabzone/api",
    "dev:db": "pnpm --filter=@cabzone/api exec tsx src/scripts/devDb.ts",
    "dev:web": "turbo run dev --filter=@cabzone/api --filter=@cabzone/web",
    "dev:full": "turbo run dev dev:worker --filter=@cabzone/api --filter=@cabzone/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck lint test",
    "seed": "pnpm --filter=@cabzone/api seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md}\""
  },
  "devDependencies": {
    "@cabzone/config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
